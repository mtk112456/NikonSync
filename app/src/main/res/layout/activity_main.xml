<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/sync_bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="20dp"
        android:paddingBottom="36dp">

        <!-- 顶部导航栏与标题 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@mipmap/ic_launcher"
                android:importantForAccessibility="no"
                android:layout_marginEnd="12dp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/app_name"
                android:textSize="24sp"
                android:textColor="@color/sync_ink"
                android:textStyle="bold" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnOpenGuide"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:paddingHorizontal="12dp"
                android:paddingVertical="0dp"
                android:text="配对指南"
                android:textColor="@color/sync_gold_ink"
                android:textSize="12sp"
                app:cornerRadius="8dp"
                app:strokeColor="@color/sync_gold" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCheckUpdate"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginStart="4dp"
                android:paddingHorizontal="6dp"
                android:paddingVertical="0dp"
                android:text="检查更新"
                android:textColor="@color/sync_muted"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- 状态卡片 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="16dp"
            android:background="@drawable/sync_panel"
            android:padding="16dp">

            <TextView
                android:id="@+id/tvStatusBadge"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:accessibilityLiveRegion="polite"
                android:text="@string/idle"
                android:textSize="17sp"
                android:textColor="@color/sync_muted"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvStatusText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/wifi_hint"
                android:textSize="13sp"
                android:textColor="@color/sync_muted" />
        </LinearLayout>

        <!-- 相机连接 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="12dp"
            android:background="@drawable/sync_panel"
            android:padding="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/connection_title"
                android:textSize="16sp"
                android:textColor="@color/sync_ink"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:labelFor="@+id/etCameraIp"
                android:text="相机 IP"
                android:textSize="12sp"
                android:textColor="@color/sync_muted" />

            <EditText
                android:id="@+id/etCameraIp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:minHeight="46dp"
                android:background="@drawable/sync_field"
                android:paddingHorizontal="12dp"
                android:paddingVertical="8dp"
                android:text="@string/default_ip"
                android:textColor="@color/sync_ink"
                android:fontFamily="monospace"
                android:textSize="15sp"
                android:inputType="textUri"
                android:singleLine="true"
                android:imeOptions="actionDone" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnScanLocalCamera"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_weight="1"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="0dp"
                    android:text="自动扫描"
                    android:textSize="12sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnResetDefaultIp"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_marginStart="8dp"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="0dp"
                    android:text="默认 IP"
                    android:textSize="11sp" />
            </LinearLayout>

            <!-- 传输格式 -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="传输格式"
                android:textSize="13sp"
                android:textColor="@color/sync_muted" />

            <RadioGroup
                android:id="@+id/rgFormatMode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:orientation="horizontal">

                <RadioButton
                    android:id="@+id/rbFormatJpg"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="仅 JPG"
                    android:textColor="@color/sync_ink"
                    android:textSize="13sp" />

                <RadioButton
                    android:id="@+id/rbFormatAll"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:text="JPG + RAW"
                    android:textColor="@color/sync_ink"
                    android:textSize="13sp" />

                <RadioButton
                    android:id="@+id/rbFormatRaw"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:text="仅 RAW"
                    android:textColor="@color/sync_ink"
                    android:textSize="13sp" />
            </RadioGroup>

            <!-- 自动连接控制 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="4dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="自动连接"
                    android:textColor="@color/sync_ink"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/switchAutoConnect"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnConnect"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                android:text="@string/connect"
                android:textColor="@color/sync_gold_ink"
                android:textSize="15sp"
                android:textStyle="bold"
                app:backgroundTint="@color/sync_gold"
                app:cornerRadius="12dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnShutter"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginTop="8dp"
                android:enabled="false"
                android:text="@string/shutter"
                android:textColor="@color/sync_ink"
                android:textSize="14sp"
                app:cornerRadius="12dp"
                app:strokeColor="@color/sync_border" />
        </LinearLayout>

        <!-- 扩展功能 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="12dp"
            android:background="@drawable/sync_panel"
            android:padding="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="扩展功能"
                android:textSize="16sp"
                android:textColor="@color/sync_ink"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnOpenGallery"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:text="相机画廊"
                    android:textColor="@color/sync_ink"
                    android:textSize="13sp"
                    app:cornerRadius="10dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnOpenPictureControl"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:text="色彩管理"
                    android:textColor="@color/sync_ink"
                    android:textSize="13sp"
                    app:cornerRadius="10dp" />
            </LinearLayout>

            <!-- 蓝牙 GPS 定位中继 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="10dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="蓝牙 GPS 写入"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="@color/sync_ink" />

                    <TextView
                        android:id="@+id/tvGpsStatus"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="未启动"
                        android:textSize="11sp"
                        android:textColor="@color/sync_muted" />
                </LinearLayout>

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/switchGpsRelay"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>
        </LinearLayout>

        <!-- 最近传图预览 -->
        <LinearLayout
            android:id="@+id/photoSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="12dp"
            android:background="@drawable/sync_panel"
            android:padding="16dp"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/latest_photo"
                android:textSize="15sp"
                android:textColor="@color/sync_ink"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/ivLastPhoto"
                android:layout_width="match_parent"
                android:layout_height="220dp"
                android:layout_marginTop="10dp"
                android:scaleType="centerCrop"
                android:background="@drawable/sync_field"
                android:clipToOutline="true"
                android:importantForAccessibility="no" />
        </LinearLayout>

        <!-- 运行日志 (完全可折叠) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="12dp"
            android:background="@drawable/sync_panel"
            android:padding="16dp">

            <LinearLayout
                android:id="@+id/layoutLogToggle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="运行日志"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="@color/sync_ink" />

                <TextView
                    android:id="@+id/tvLogBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="11sp"
                    android:paddingHorizontal="6dp"
                    android:paddingVertical="2dp"
                    android:background="@drawable/sync_field"
                    android:textColor="@color/sync_muted" />

                <TextView
                    android:id="@+id/tvLogToggleIcon"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="展开 ▾"
                    android:textSize="13sp"
                    android:textColor="@color/sync_gold_ink" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/layoutLogContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="10dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/tvLogConsole"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/sync_console"
                    android:padding="12dp"
                    android:textIsSelectable="true"
                    android:fontFamily="monospace"
                    android:text="@string/log_ready"
                    android:textSize="12sp"
                    android:textColor="@color/sync_log_text" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="end">

                    <TextView
                        android:id="@+id/btnClearLog"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:padding="6dp"
                        android:text="清空"
                        android:textSize="12sp"
                        android:textColor="@color/sync_muted" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
