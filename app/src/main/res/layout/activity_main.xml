<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true"
    android:background="@color/sync_canvas">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"
        android:focusableInTouchMode="true" android:paddingHorizontal="20dp"
        android:paddingTop="20dp" android:paddingBottom="28dp">

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
            <ImageView android:layout_width="62dp" android:layout_height="62dp" android:src="@mipmap/ic_launcher"
                android:importantForAccessibility="no" android:layout_marginEnd="14dp" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:letterSpacing="0.16"
                    android:text="@string/eyebrow" android:textSize="11sp"
                    android:textColor="@color/sync_gold_ink" android:textStyle="bold" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="@string/app_name" android:textSize="30sp"
                    android:textColor="@color/sync_ink" android:textStyle="bold" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="@string/subtitle" android:textSize="14sp"
                    android:textColor="@color/sync_muted" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginTop="20dp"
            android:background="@drawable/sync_panel" android:padding="18dp">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:id="@+id/tvStatusBadge" android:accessibilityLiveRegion="polite"
                android:text="@string/idle" android:textSize="17sp"
                android:textColor="@color/sync_muted" android:textStyle="bold" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:id="@+id/tvStatusText" android:layout_marginTop="5dp"
                android:text="@string/wifi_hint" android:textSize="14sp"
                android:textColor="@color/sync_muted" />
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginTop="12dp"
            android:background="@drawable/sync_panel" android:padding="18dp">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="@string/connection_title" android:textSize="18sp"
                android:textColor="@color/sync_ink" android:textStyle="bold" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:labelFor="@+id/etCameraIp"
                android:text="@string/ip_label" android:textSize="13sp"
                android:textColor="@color/sync_muted" />
            <EditText android:id="@+id/etCameraIp" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="5dp" android:minHeight="48dp" android:background="@drawable/sync_field"
                android:paddingHorizontal="12dp" android:paddingVertical="10dp"
                android:text="@string/default_ip" android:textColor="@color/sync_ink"
                android:fontFamily="monospace" android:textSize="16sp"
                android:inputType="textUri" android:singleLine="true" android:imeOptions="actionDone" />
            <com.google.android.material.button.MaterialButton android:id="@+id/btnConnect" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="10dp" android:enabled="false" android:textColor="@color/sync_ink"
                android:minHeight="52dp" android:text="@string/connect" android:textAllCaps="false"
                android:textSize="15sp" app:cornerRadius="14dp" />
            <com.google.android.material.button.MaterialButton android:id="@+id/btnShutter" android:layout_width="match_parent" android:layout_height="wrap_content"
                style="@style/Widget.Material3.Button.OutlinedButton" android:layout_marginTop="4dp"
                android:enabled="false" android:minHeight="52dp" android:textColor="@color/sync_muted"
                android:text="@string/shutter" android:textAllCaps="false"
                android:textSize="15sp" app:cornerRadius="14dp" />
        </LinearLayout>

        <LinearLayout android:id="@+id/photoSection" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"
            android:layout_marginTop="18dp" android:visibility="gone">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="@string/latest_photo" android:textSize="16sp"
                android:textColor="@color/sync_ink" android:textStyle="bold" />
            <ImageView android:id="@+id/ivLastPhoto" android:layout_width="match_parent" android:layout_height="200dp" android:layout_marginTop="8dp"
                android:scaleType="fitCenter" android:background="@drawable/sync_panel"
                android:contentDescription="@string/latest_photo" />
        </LinearLayout>

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp"
            android:text="@string/logs" android:textSize="16sp"
            android:textColor="@color/sync_ink" android:textStyle="bold" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:id="@+id/tvLogConsole" android:layout_marginTop="8dp"
            android:background="@drawable/sync_console" android:padding="14dp"
            android:textIsSelectable="true" android:fontFamily="monospace"
            android:text="@string/log_ready" android:textSize="12sp"
            android:textColor="@color/sync_log_text" />
    </LinearLayout>
</ScrollView>
